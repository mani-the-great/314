@model IEnumerable<CourseClass>

@{
    ViewData["Title"] = "مدیریت کلاس‌های درس";
}

<h2>مدیریت کلاس‌های درس</h2>

<p>
    <a asp-action="AddClass" class="btn btn-primary">اضافه کردن کلاس جدید</a>
</p>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>عنوان درس</th>
            <th>کد درس</th>
            <th>زمان برگزاری</th>
            <th>مکان</th>
            <th>ظرفیت</th>
            <th>اساتید</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course.Title</td>
                <td>@item.Course.Code</td>
                <td>
                    @item.Day.ToString()
                    @item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")
                </td>
                <td>@item.Building - @item.RoomNumber</td>
                <td>@item.Capacity</td>
                <td>
                    @foreach (var prof in item.Professors)
                    {
                        <span>@prof.Professor.FirstName @prof.Professor.LastName</span>

                        <br />
                    }
                </td>
                <td>
                    <a asp-action="ManageClassStudents" asp-route-id="@item.Id" class="btn btn-info btn-sm">مدیریت دانشجویان</a>
                    <form asp-action="DeleteClass" method="post" class="d-inline" onsubmit="return confirm('آیا از حذف این کلاس مطمئن هستید؟');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}
