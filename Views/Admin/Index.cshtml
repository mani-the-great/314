@{
    ViewData["Title"] = "پنل مدیریت";
}

<div class="text-center">
    <h1 class="display-4">پنل مدیریت سامانه گلستان</h1>

    <div class="admin-dashboard mt-5">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">مدیریت اساتید</h5>
                        <p class="card-text">ثبت، ویرایش و حذف اطلاعات اساتید</p>
                        <a asp-action="Professors" class="btn btn-primary">ورود</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">مدیریت دانشجویان</h5>
                        <p class="card-text">ثبت، ویرایش و حذف اطلاعات دانشجویان</p>
                        <a asp-action="Students" class="btn btn-primary">ورود</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">مدیریت دروس</h5>
                        <p class="card-text">ثبت، ویرایش و حذف اطلاعات دروس</p>
                        <a asp-action="Courses" class="btn btn-primary">ورود</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">مدیریت کلاس‌ها</h5>
                        <p class="card-text">ثبت، ویرایش و حذف کلاس‌های درس</p>
                        <a asp-action="CourseClasses" class="btn btn-primary">ورود</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">مدیریت دانشکده‌ها</h5>
                        <p class="card-text">ثبت، ویرایش و حذف دانشکده‌ها</p>
                        <a asp-action="Faculties" class="btn btn-primary">ورود</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
