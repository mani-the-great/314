@model IEnumerable<Course>

@{
    ViewData["Title"] = "مدیریت دروس";
}

<h2>مدیریت دروس</h2>

<p>
    <a asp-action="AddCourse" class="btn btn-primary">اضافه کردن درس جدید</a>
</p>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>کد درس</th>
            <th>عنوان</th>
            <th>تعداد واحد</th>
            <th>دانشکده</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Title</td>
                <td>@item.Credits</td>
                <td>@item.Faculty?.Name</td>
                <td>
                    <form asp-action="DeleteCourse" method="post" onsubmit="return confirm('آیا از حذف این درس مطمئن هستید؟');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}
