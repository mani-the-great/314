@model Student

@{
    ViewData["Title"] = "پنل دانشجو";
}

<div class="text-center">
    <h1 class="display-4">@Model.FirstName @Model.LastName خوش آمدید</h1>
    
    <div class="student-dashboard mt-5">
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">کلاس‌های من</h5>
                        <a asp-action="MyCourses" class="btn btn-primary">مشاهده</a>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">نمرات من</h5>
                        <a asp-action="MyGrades" class="btn btn-primary">مشاهده</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">اطلاعات من</h5>
                        <a asp-action="MyInfo" class="btn btn-primary">مشاهده</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
