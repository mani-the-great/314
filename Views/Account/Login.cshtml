@{
    ViewData["Title"] = "ورود به حساب کاربری";
}
<center>
    <div style="border: 1px black solid;width: 70%;border-radius: 25px;">
        <h2>ورود به حساب کاربری</h2>

        <form asp-action="Login" method="post">
            <table width="64%">
                <tr>
                    <div class="form-group">
                        <td>    <label for="username">نام کاربری:</label></td>
                        <td>    <input type="text" id="username" name="username" class="form-control" required autofocus /></td>
                    </div>
                </tr>
                <tr>
                    <div class="form-group">
                        <td><label for="password">رمز عبور:</label></td>
                        <td><input type="password" id="password" name="password" class="form-control" required /></td>
                    </div>
                </tr>
                <tr style ="text-align:left">
                    <td colspan="2"><button type="submit" class="btn btn-primary" >ورود</button></td>
                </tr>
            </table>
        </form>
</center>
</div>
@if(ViewData["Login"] == "Failed"){
    <p style="color:red;">
        نام کاربری یا رمز عبور وارد شده نادرست است.
    </p>
}
@if (ViewData["ReturnUrl"] != null)
{
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
}
